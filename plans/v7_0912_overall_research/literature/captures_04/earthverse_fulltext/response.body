<span id="S0.F1.2.1.1" class="ltx_inline-block ltx_minipage ltx_align_middle" style="width:310.5pt;">
<span id="S0.F1.2.1.1.1" class="ltx_block ltx_minipage ltx_align_center ltx_align_top" style="width:118.0pt;"><img src="2608.23525v1/figures/main_text/view-show.png" id="S0.F1.g1" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:163/163;" width="163" height="163" alt="Refer to caption">
<span id="S0.F1.2.1.1.1.1" class="ltx_p ltx_align_center"><span id="S0.F1.2.1.1.1.1.1" class="ltx_text ltx_font_bold">(a)</span> Scientific coverage.</span>
</span>
<span id="S0.F1.2.1.1.2" class="ltx_block ltx_minipage ltx_align_center ltx_align_top" style="width:186.3pt;"><img src="2608.23525v1/figures/main_text/model_quality_tokens.jpg" id="S0.F1.g2" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:257/152;" width="257" height="152" alt="Refer to caption">
<span id="S0.F1.2.1.1.2.1" class="ltx_p ltx_align_center"><span id="S0.F1.2.1.1.2.1.1" class="ltx_text ltx_font_bold">(b)</span> Leaderboard landscape.</span>
</span>
</span></span></p>
