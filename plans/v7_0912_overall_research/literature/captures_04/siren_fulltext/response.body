<td id="S3.T2.2.1.32.5" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r"><span id="S3.T2.2.1.32.5.1" class="ltx_text" style="font-size:70%;">0.241</span></td>
<td id="S3.T2.2.1.32.6" class="ltx_td ltx_align_center ltx_border_bb"><span id="S3.T2.2.1.32.6.1" class="ltx_text" style="font-size:70%;">1.000</span></td>
<td id="S3.T2.2.1.32.7" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r"><span id="S3.T2.2.1.32.7.1" class="ltx_text" style="font-size:70%;">0.981</span></td>
<td id="S3.T2.2.1.32.8" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r"><span id="S3.T2.2.1.32.8.1" class="ltx_text" style="font-size:70%;">0.407</span></td>
<td id="S3.T2.2.1.32.9" class="ltx_td ltx_align_center ltx_border_bb"><span id="S3.T2.2.1.32.9.1" class="ltx_text" style="font-size:70%;">1.000</span></td>
<td id="S3.T2.2.1.32.10" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r"><span id="S3.T2.2.1.32.10.1" class="ltx_text" style="font-size:70%;">1.000</span></td>
<td id="S3.T2.2.1.32.11" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r"><span id="S3.T2.2.1.32.11.1" class="ltx_text ltx_underline ltx_font_italic" style="font-size:70%;">0.300</span></td>
<td id="S3.T2.2.1.32.12" class="ltx_td ltx_align_center ltx_border_bb"><span id="S3.T2.2.1.32.12.1" class="ltx_text" style="font-size:70%;">1.000</span></td>
<td id="S3.T2.2.1.32.13" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r"><span id="S3.T2.2.1.32.13.1" class="ltx_text" style="font-size:70%;">0.975</span></td>
<td id="S3.T2.2.1.32.14" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r"><span id="S3.T2.2.1.32.14.1" class="ltx_text ltx_underline ltx_font_italic" style="font-size:70%;">0.340</span></td>
