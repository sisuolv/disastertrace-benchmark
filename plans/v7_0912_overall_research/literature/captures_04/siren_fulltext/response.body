<td id="A1.T5.2.4.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.35pt 3.2pt;"><span id="A1.T5.2.4.3.1" class="ltx_text" style="font-size:90%;">SD</span></td>
<td id="A1.T5.2.4.4" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.35pt 3.2pt;"><span id="A1.T5.2.4.4.1" class="ltx_text" style="font-size:90%;">GL</span></td>
<td id="A1.T5.2.4.5" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.35pt 3.2pt;"><span id="A1.T5.2.4.5.1" class="ltx_text" style="font-size:90%;">Which state and county are currently experiencing this event?</span></td></tr>
