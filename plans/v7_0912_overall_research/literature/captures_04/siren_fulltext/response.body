<td id="A1.T5.2.4.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding:0.35pt 3.2pt;" rowspan="5"><span id="A1.T5.2.4.1.1" class="ltx_text" style="font-size:90%;"><span id="A1.T5.2.4.1.1.1" class="ltx_text"></span> <span id="A1.T5.2.4.1.1.2" class="ltx_text">
<span id="A1.T5.2.4.1.1.2.1" class="ltx_tabular ltx_align_middle">
<span id="A1.T5.2.4.1.1.2.1.1" class="ltx_tr">
<span id="A1.T5.2.4.1.1.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding:0.35pt 3.2pt;">Spatiotemporal</span></span>
<span id="A1.T5.2.4.1.1.2.1.2" class="ltx_tr">
<span id="A1.T5.2.4.1.1.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding:0.35pt 3.2pt;">Prediction</span></span>
