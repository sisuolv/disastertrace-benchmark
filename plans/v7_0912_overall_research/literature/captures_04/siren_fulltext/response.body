<td id="A9.T8.2.1.1" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="A9.T8.2.1.1.1" class="ltx_text ltx_font_bold">Agree. Rate</span></td>
<td id="A9.T8.2.1.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="A9.T8.2.1.2.1" class="ltx_text ltx_font_bold">Kendall Tau</span></td>
<td id="A9.T8.2.1.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="A9.T8.2.1.3.1" class="ltx_text ltx_font_bold">Spearman Coeff.</span></td></tr>
