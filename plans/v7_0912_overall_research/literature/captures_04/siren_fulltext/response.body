<td id="A9.T8.2.2.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;">87.05</td></tr>
</table>
</figure>
<figure id="A9.T9" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">Table 9. </span>LLM–human alignment performance for the 0–10 scale evaluator (%).</figcaption>
<table id="A9.T9.2" class="ltx_tabular ltx_centering ltx_align_middle">
<tr id="A9.T9.2.1" class="ltx_tr">
<td id="A9.T9.2.1.1" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="A9.T9.2.1.1.1" class="ltx_text ltx_font_bold">Agree. Rate</span></td>
<td id="A9.T9.2.1.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="A9.T9.2.1.2.1" class="ltx_text ltx_font_bold">Kendall Tau</span></td>
