<td id="A3.T7.2.1.1.3" class="ltx_td ltx_align_left ltx_border_tt" style="padding:0.35pt 3.2pt;"><span id="A3.T7.2.1.1.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Description</span></td></tr>
<tr id="A3.T7.2.1.2" class="ltx_tr">
<td id="A3.T7.2.1.2.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding:0.35pt 3.2pt;" rowspan="6"><span id="A3.T7.2.1.2.1.1" class="ltx_text" style="font-size:90%;"><span id="A3.T7.2.1.2.1.1.1" class="ltx_text"></span><span id="A3.T7.2.1.2.1.1.2" class="ltx_text">
