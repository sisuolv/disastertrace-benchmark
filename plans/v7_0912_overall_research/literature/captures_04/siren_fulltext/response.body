<td id="A1.T5.2.5.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.35pt 3.2pt;"><span id="A1.T5.2.5.2.1" class="ltx_text" style="font-size:90%;">TP</span></td>
<td id="A1.T5.2.5.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.35pt 3.2pt;"><span id="A1.T5.2.5.3.1" class="ltx_text" style="font-size:90%;">MC</span></td>
