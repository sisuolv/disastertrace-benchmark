<th id="S4.T8.6.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding:0.3pt 5.0pt;"><span id="S4.T8.6.1.4.1.1" class="ltx_text" style="font-size:70%;">GPT-5.5 </span><cite class="ltx_cite ltx_citemacro_cite"><span id="S4.T8.6.1.4.1.2" class="ltx_text" style="font-size:70%;">[</span><a href="#bib.bib53" title="" class="ltx_ref">53</a><span id="S4.T8.6.1.4.1.3" class="ltx_text" style="font-size:70%;">]</span></cite></th>
<td id="S4.T8.6.1.4.2" class="ltx_td ltx_align_center" style="padding:0.3pt 5.0pt;"><span id="S4.T8.6.1.4.2.1" class="ltx_text ltx_font_bold" style="font-size:70%;">0.3138</span></td>
<td id="S4.T8.6.1.4.3" class="ltx_td ltx_align_center" style="padding:0.3pt 5.0pt;"><span id="S4.T8.6.1.4.3.1" class="ltx_text ltx_font_bold" style="font-size:70%;">0.3058</span></td>
<td id="S4.T8.6.1.4.4" class="ltx_td ltx_align_center" style="padding:0.3pt 5.0pt;"><span id="S4.T8.6.1.4.4.1" class="ltx_text ltx_font_bold" style="font-size:70%;">0.2916</span></td>
<td id="S4.T8.6.1.4.5" class="ltx_td ltx_align_center" style="padding:0.3pt 5.0pt;"><span id="S4.T8.6.1.4.5.1" class="ltx_text ltx_font_bold" style="font-size:70%;">0.2978</span></td>
<td id="S4.T8.6.1.4.6" class="ltx_td ltx_align_center" style="padding:0.3pt 5.0pt;"><span id="S4.T8.6.1.4.6.1" class="ltx_text ltx_font_bold" style="font-size:70%;">0.2794</span></td></tr>
<tr id="S4.T8.6.1.5" class="ltx_tr">
<th id="S4.T8.6.1.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding:0.3pt 5.0pt;"><span id="S4.T8.6.1.5.1.1" class="ltx_text" style="font-size:70%;">Kimi-k2.6-1T </span><cite class="ltx_cite ltx_citemacro_cite"><span id="S4.T8.6.1.5.1.2" class="ltx_text" style="font-size:70%;">[</span><a href="#bib.bib54" title="" class="ltx_ref">54</a><span id="S4.T8.6.1.5.1.3" class="ltx_text" style="font-size:70%;">]</span></cite></th>
<td id="S4.T8.6.1.5.2" class="ltx_td ltx_align_center" style="padding:0.3pt 5.0pt;"><span id="S4.T8.6.1.5.2.1" class="ltx_text" style="font-size:70%;">0.2440</span></td>
<td id="S4.T8.6.1.5.3" class="ltx_td ltx_align_center" style="padding:0.3pt 5.0pt;"><span id="S4.T8.6.1.5.3.1" class="ltx_text" style="font-size:70%;">0.2127</span></td>
<td id="S4.T8.6.1.5.4" class="ltx_td ltx_align_center" style="padding:0.3pt 5.0pt;"><span id="S4.T8.6.1.5.4.1" class="ltx_text" style="font-size:70%;">0.2357</span></td>
<td id="S4.T8.6.1.5.5" class="ltx_td ltx_align_center" style="padding:0.3pt 5.0pt;"><span id="S4.T8.6.1.5.5.1" class="ltx_text" style="font-size:70%;">0.2324</span></td>
<td id="S4.T8.6.1.5.6" class="ltx_td ltx_align_center" style="padding:0.3pt 5.0pt;"><span id="S4.T8.6.1.5.6.1" class="ltx_text" style="font-size:70%;">0.2128</span></td></tr>
