                  {
                    "exclusiveMinimum": 0,
                    "type": "integer"
                  },
                  {
                    "minimum": 0,
                    "type": "integer"
                  },
                  {
                    "exclusiveMinimum": 0,
                    "type": "integer"
                  }
                ],
                "type": "array"
              },
              {
                "type": "null"
